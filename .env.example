# Turso Cloud Database Configuration
#
# Server-side Environment Variables (for Vercel Serverless Functions in /api):
TURSO_DATABASE_URL=libsql://your-database-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token


# Client-side Expo Environment Variables (optional fallback):
EXPO_PUBLIC_TURSO_DATABASE_URL=libsql://your-database-name-org.turso.io
EXPO_PUBLIC_TURSO_AUTH_TOKEN=your-turso-auth-token
EXPO_PUBLIC_APP_PASSWORD=your-app-password

# Server-side App Authentication
APP_PASSWORD=your-app-password

# Optional: Absolute URL for OG/social media image paths.
# If not set, Vercel's auto-injected VERCEL_PROJECT_PRODUCTION_URL is used during builds.
# Only needed if you use a custom domain or non-Vercel hosting.
# SITE_URL=https://your-custom-domain.com
