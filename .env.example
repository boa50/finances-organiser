# Turso Cloud Database Configuration
# If these environment variables are provided, FinanceCloud will automatically connect to Turso DB.
# If they are omitted, the app will let you configure them at runtime through the Turso Cloud modal.

EXPO_PUBLIC_TURSO_DATABASE_URL=libsql://your-database-name-org.turso.io
EXPO_PUBLIC_TURSO_AUTH_TOKEN=your-turso-auth-token
